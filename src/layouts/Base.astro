---
import "../styles/global.css";
import { site } from "../site";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
}
const { title, description = site.description, type = "website" } = Astro.props;
const fullTitle = title ? `${title} • ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const here = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.title} />
    <meta name="theme-color" content="#171717" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/img/logo/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/index.xml" />
    <link rel="preload" href="/fonts/Switzer.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <div class="mx-auto flex min-h-screen max-w-2xl flex-col px-5">
      <header class="flex items-center justify-between py-6">
        <a href="/" class="text-neutral-500 transition-colors hover:text-white">{site.title}</a>
        <nav class="flex gap-4 text-neutral-500">
          {site.nav.map((item) => (
            <a
              href={item.url}
              class:list={["transition-colors hover:text-white", here.startsWith(item.url) && "text-neutral-200"]}
            >
              {item.name}
            </a>
          ))}
        </nav>
      </header>

      <main class="flex-1 py-8">
        <slot />
      </main>

      <footer class="flex items-center justify-between border-t border-neutral-800 py-6 text-sm text-neutral-500">
        <span>{site.title} • {new Date().getFullYear()}</span>
        <div class="flex gap-4">
          {site.socials.map((s) => <a href={s.url} class="transition-colors hover:text-white">{s.name}</a>)}
        </div>
      </footer>
    </div>
  </body>
</html>
