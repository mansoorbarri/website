---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import PostList from "../../components/PostList.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import { getPosts } from "../../lib/posts";

const posts = await getPosts();
const years = Map.groupBy(posts, (p) => p.data.date.getUTCFullYear());
---

<Base title="Blogs" description="Guides and notes on Linux, Windows, Hugo, web development and more.">
  <PageHeader title="blogs" count={posts.length}>guides and notes on linux, windows, hugo, web dev and whatever else.</PageHeader>
  <div class="flex flex-col gap-12">
    {[...years].map(([year, list]) => (
      <section>
        <SectionTitle>{year}</SectionTitle>
        <PostList posts={list} />
      </section>
    ))}
  </div>
</Base>
