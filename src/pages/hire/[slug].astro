---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { site } from "../../site";

export async function getStaticPaths() {
  const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}

const { entry, next } = Astro.props as { entry: CollectionEntry<"work">; next: CollectionEntry<"work"> };
const { Content } = await render(entry);
const { title, summary, role, period, stack, live, source } = entry.data;
---

<Base title={`${title} case study`} description={summary} type="article">
  <a href="/hire/" class="text-sm text-neutral-500 transition-colors hover:text-white">← all case studies</a>

  <header class="mt-6 mb-10">
    <h1 class="text-3xl font-semibold text-neutral-100">{title}</h1>
    <p class="mt-3 text-neutral-400">{summary}</p>
    <dl class="mt-6 grid grid-cols-2 gap-x-6 gap-y-4 rounded-lg border border-neutral-800 bg-surface p-5 text-sm sm:grid-cols-4">
      <div><dt class="text-neutral-500">Role</dt><dd class="mt-1 text-neutral-200">{role}</dd></div>
      <div><dt class="text-neutral-500">When</dt><dd class="mt-1 text-neutral-200">{period}</dd></div>
      <div class="col-span-2"><dt class="text-neutral-500">Stack</dt><dd class="mt-1 text-neutral-200">{stack.join(", ")}</dd></div>
    </dl>
    <div class="mt-4 flex gap-5 text-sm">
      {live && <a href={live} class="link text-neutral-200">Live site ↗</a>}
      {source && <a href={source} class="link text-neutral-200">Source ↗</a>}
    </div>
  </header>

  <div class="prose prose-neutral">
    <Content />
  </div>

  <div class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-neutral-800 pt-6 text-sm">
    <a href={`mailto:${site.email}`} class="link text-neutral-200">Like this? Get in touch →</a>
    <a href={`/hire/${next.id}/`} class="text-neutral-500 transition-colors hover:text-white">Next: {next.data.title} →</a>
  </div>
</Base>
