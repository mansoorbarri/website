---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { site } from "../../site";

export async function getStaticPaths() {
  const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}

const { entry, next } = Astro.props as { entry: CollectionEntry<"work">; next: CollectionEntry<"work"> };
const { Content } = await render(entry);
const { title, summary, role, period, stack, live, source } = entry.data;
---

<Base title={`${title} case study`} description={summary} type="article" width="narrow">
  <article class="rise">
    <header class="mb-12 border-b border-white/10 pb-8">
      <a href="/hire/" class="text-sm text-muted transition-colors duration-200 hover:text-text">← case studies</a>
      <h1 class="mt-6 mb-3 text-2xl font-medium tracking-tight">{title}</h1>
      <p class="text-subtle">{summary}</p>
      <dl class="mt-8 grid grid-cols-[4rem_1fr] gap-x-4 gap-y-2 text-sm">
        <dt class="text-muted">role</dt><dd>{role}</dd>
        <dt class="text-muted">when</dt><dd>{period}</dd>
        <dt class="text-muted">stack</dt><dd>{stack.join(", ")}</dd>
      </dl>
      {(live || source) && (
        <div class="mt-6 flex gap-5 text-sm">
          {live && <a href={live} class="link">live site ↗</a>}
          {source && <a href={source} class="link">source ↗</a>}
        </div>
      )}
    </header>

    <div class="prose prose-invert">
      <Content />
    </div>
  </article>

  <div class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-white/5 pt-6 text-sm">
    <a href={`mailto:${site.email}`} class="link">like this? get in touch →</a>
    <a href={`/hire/${next.id}/`} class="text-muted transition-colors duration-200 hover:text-text">next: {next.data.title} →</a>
  </div>
</Base>
