---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Row from "../../components/Row.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import { site } from "../../site";

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Hire me" description="Full-stack developer building real-time web apps with Next.js, TypeScript and Convex. Open to roles and freelance projects.">
  <PageHeader title="hire">open to roles and freelance work.</PageHeader>

  <section class="rise mb-16" style="--i:1">
    <p class="text-xl leading-snug tracking-tight">I build real-time web apps, from the database to the pixels.</p>
    <p class="mt-4 leading-relaxed text-subtle">
      I'm Mansoor, a full-stack developer in the North West of England with a D*D*D BTEC in IT.
      I mostly work with <span class="text-text">Next.js, TypeScript, Convex and Tailwind</span>, and I ship products that real people use,
      including one with a paid subscription tier. Below are four of them, with the problems they solve and how they're built.
    </p>
  </section>

  <section class="mb-16">
    <SectionTitle>case studies</SectionTitle>
    <div class="flex flex-col">
      {work.map((w, i) => (
        <Row href={`/hire/${w.id}/`} i={i + 2}>
          <span class="mr-3 text-muted tabular-nums">0{i + 1}</span>{w.data.title}
          <span class="mt-1 block text-sm text-muted">{w.data.summary}</span>
        </Row>
      ))}
    </div>
  </section>

  <section class="grid gap-4 sm:grid-cols-2">
    <div class="rise rounded-lg border border-white/5 bg-surface p-6" style="--i:6">
      <h3 class="text-text">hiring for a role?</h3>
      <p class="mt-2 text-sm leading-relaxed text-subtle">
        I'm looking for junior developer roles and software degree apprenticeships. Happy to talk through any of the code above.
      </p>
    </div>
    <div class="rise rounded-lg border border-white/5 bg-surface p-6" style="--i:7">
      <h3 class="text-text">need something built?</h3>
      <p class="mt-2 text-sm leading-relaxed text-subtle">
        Web apps, dashboards, internal tools and sites with real-time data, accounts or payments. Tell me what you need and I'll come back with a plan.
      </p>
    </div>
  </section>

  <p class="rise mt-10 text-sm text-muted" style="--i:8">
    reach me at <a href={`mailto:${site.email}`} class="link">{site.email}</a>.
  </p>
</Base>
