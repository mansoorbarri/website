---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import { site } from "../../site";

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Hire me" description="Full-stack developer building real-time web apps with Next.js, TypeScript and Convex. Open to roles and freelance projects.">
  <section>
    <p class="text-sm text-neutral-500">hire.</p>
    <h1 class="mt-1 text-2xl leading-snug font-semibold text-neutral-100">
      I build real-time web apps, from the database to the pixels.
    </h1>
    <p class="mt-4 text-neutral-400">
      I'm Mansoor, a full-stack developer in the North West of England with a D*D*D BTEC in IT.
      I mostly work with <span class="text-neutral-200">Next.js, TypeScript, Convex and Tailwind</span>, and I ship products that real people use,
      including one with a paid subscription tier. Below are four of them, with the problems they solve and how they're built.
    </p>
  </section>

  <section class="mt-14">
    <SectionTitle>Case studies</SectionTitle>
    <ol class="flex flex-col divide-y divide-neutral-800 border-y border-neutral-800">
      {work.map((w, i) => (
        <li>
          <a href={`/hire/${w.id}/`} class="group flex gap-5 py-6">
            <span class="pt-0.5 text-sm text-neutral-600 tabular-nums">0{i + 1}</span>
            <div class="flex-1">
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="font-medium text-neutral-100 underline decoration-neutral-700 underline-offset-4 transition-colors group-hover:decoration-neutral-400">
                  {w.data.title}
                </h3>
                <span class="shrink-0 text-sm text-neutral-600">{w.data.period}</span>
              </div>
              <p class="mt-2 text-neutral-400">{w.data.summary}</p>
              <p class="mt-3 text-xs text-neutral-500">{w.data.stack.join(" · ")}</p>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="mt-14 grid gap-4 sm:grid-cols-2">
    <div class="rounded-lg border border-neutral-800 bg-surface p-5">
      <h3 class="font-medium text-neutral-100">Hiring for a role?</h3>
      <p class="mt-2 text-sm text-neutral-400">
        I'm looking for junior developer roles and software degree apprenticeships. Happy to talk through any of the code above.
      </p>
      <a href={site.resume} class="link mt-4 inline-block text-sm text-neutral-200">Download my CV →</a>
    </div>
    <div class="rounded-lg border border-neutral-800 bg-surface p-5">
      <h3 class="font-medium text-neutral-100">Need something built?</h3>
      <p class="mt-2 text-sm text-neutral-400">
        Web apps, dashboards, internal tools and sites with real-time data, accounts or payments. Tell me what you need and I'll come back with a plan.
      </p>
      <a href={`mailto:${site.email}?subject=Project%20enquiry`} class="link mt-4 inline-block text-sm text-neutral-200">Email me →</a>
    </div>
  </section>

  <p class="mt-10 text-sm text-neutral-500">
    Or reach me at <a href={`mailto:${site.email}`} class="link text-neutral-300">{site.email}</a>,
    on <a href="https://github.com/mansoorbarri" class="link text-neutral-300">GitHub</a> or{" "}
    <a href="https://www.linkedin.com/in/mansoorbarri/" class="link text-neutral-300">LinkedIn</a>.
  </p>
</Base>
