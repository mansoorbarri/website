---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import { formatDate, getPosts, slugify, type Post } from "../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.data.url.replace(/^\/|\/$/g, "") },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const { title, description, date, tags, draft } = post.data;
---

<Base title={title} description={description} type="article">
  <article>
    <header class="mb-10">
      <h1 class="text-3xl leading-tight font-semibold text-neutral-100">
        {title}{draft && <span class="ml-2 text-sm text-amber-500">draft</span>}
      </h1>
      {description && <p class="mt-3 text-neutral-400">{description}</p>}
      <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-neutral-500">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {tags.map((t) => <a href={`/tags/${slugify(t)}/`} class="hover:text-white">#{slugify(t)}</a>)}
      </div>
    </header>

    <div class="prose prose-neutral">
      <Content />
    </div>
  </article>

  <hr class="my-12 border-neutral-800" />
  <script
    is:inline
    src="https://utteranc.es/client.js"
    repo="mansoorbarri/website"
    issue-term="title"
    label="comments"
    theme="photon-dark"
    crossorigin="anonymous"
    async></script>

  <script>
    for (const pre of document.querySelectorAll<HTMLPreElement>(".prose pre")) {
      const btn = document.createElement("button");
      btn.className = "copy-btn";
      btn.textContent = "copy";
      btn.addEventListener("click", async () => {
        await navigator.clipboard.writeText(pre.querySelector("code")?.innerText ?? pre.innerText);
        btn.textContent = "copied";
        setTimeout(() => (btn.textContent = "copy"), 1200);
      });
      pre.append(btn);
    }
  </script>
</Base>
