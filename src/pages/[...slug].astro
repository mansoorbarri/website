---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import { formatDate, getPosts, slugify, type Post } from "../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.data.url.replace(/^\/|\/$/g, "") },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const { title, description, date, tags, draft } = post.data;
---

<Base title={title} description={description} type="article" width="narrow">
  <article class="rise">
    <header class="mb-12 border-b border-white/10 pb-8">
      <h1 class="mb-3 text-2xl leading-snug font-medium tracking-tight">
        {title}{draft && <span class="ml-2 text-sm text-amber-500">draft</span>}
      </h1>
      {description && <p class="mb-4 text-subtle">{description}</p>}
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {tags.map((t) => <a href={`/tags/${slugify(t)}/`} class="transition-colors duration-200 hover:text-text">#{slugify(t)}</a>)}
      </div>
    </header>

    <div class="prose prose-invert">
      <Content />
    </div>
  </article>

  <a href="/blogs/" class="group mt-12 inline-flex items-center gap-2 text-sm text-muted transition-colors duration-200 hover:text-text">
    <span class="transition-transform duration-200 group-hover:-translate-x-0.5">←</span> blogs
  </a>

  <hr class="my-12 border-white/5" />
  <script
    is:inline
    src="https://utteranc.es/client.js"
    repo="mansoorbarri/website"
    issue-term="title"
    label="comments"
    theme="photon-dark"
    crossorigin="anonymous"
    async></script>

  <script>
    for (const pre of document.querySelectorAll<HTMLPreElement>(".prose pre")) {
      const btn = document.createElement("button");
      btn.className = "copy-btn";
      btn.textContent = "copy";
      btn.addEventListener("click", async () => {
        await navigator.clipboard.writeText(pre.querySelector("code")?.innerText ?? pre.innerText);
        btn.textContent = "copied";
        setTimeout(() => (btn.textContent = "copy"), 1200);
      });
      pre.append(btn);
    }
  </script>
</Base>
