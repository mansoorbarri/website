---
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { getPosts } from "../lib/posts";
import { site } from "../site";

const posts = (await getPosts()).slice(0, 8);
---

<Base>
  <section>
    <p class="text-sm text-neutral-500">{site.wiki}</p>
    <p class="mt-1 text-neutral-300 [&_strong]:font-semibold [&_strong]:text-white" set:html={site.hero} />
    <p class="mt-4 text-neutral-400">
      Building something? <a href="/hire/" class="link text-neutral-200">I'm available for work</a>.
    </p>
  </section>

  <section class="mt-14">
    <SectionTitle>Projects</SectionTitle>
    <div class="grid grid-cols-2 gap-6 sm:grid-cols-3">
      {site.projects.map((p) => (
        <div>
          <a href={p.url} class="link font-medium text-neutral-100">{p.name}</a>
          <p class="mt-2 text-sm text-neutral-400">{p.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mt-14">
    <SectionTitle>Blog</SectionTitle>
    <PostList posts={posts} />
    <a href="/blogs/" class="mt-6 inline-block text-sm text-neutral-500 transition-colors hover:text-white">all posts →</a>
  </section>
</Base>
