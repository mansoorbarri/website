---
import Base from "../layouts/Base.astro";
import PageHeader from "./PageHeader.astro";
import PostList from "./PostList.astro";
import type { Post } from "../lib/posts";
interface Props { label: string; name: string; posts: Post[] }
const { label, name, posts } = Astro.props;
---

<Base title={name} description={`Posts filed under ${name}.`}>
  <PageHeader title={name} count={posts.length}>{label.toLowerCase()}</PageHeader>
  <PostList posts={posts} start={1} />
</Base>
