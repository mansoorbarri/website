---
interface Props { title: string; count?: number }
const { title, count } = Astro.props;
---

<header class="rise mb-16">
  <h1 class="text-2xl tracking-tight">{title}{count !== undefined && <span class="ml-3 text-muted">{count}</span>}</h1>
  {Astro.slots.has("default") && <p class="mt-2 text-sm text-muted"><slot /></p>}
</header>
