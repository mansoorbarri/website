---
import Row from "./Row.astro";
import { formatDate, type Post } from "../lib/posts";
interface Props { posts: Post[]; start?: number }
const { posts, start = 0 } = Astro.props;
---

<div class="flex flex-col">
  {posts.map((post, n) => (
    <Row href={post.data.url} i={start + n} meta={formatDate(post.data.date)}>{post.data.title}</Row>
  ))}
</div>
